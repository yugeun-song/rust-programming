# Rust build artifacts
/target
/tools/scaffold/target
**/*.rs.bk

# scaffold's lock and temporary manifest, present only during a run
/.scaffold.lock
/.Cargo.toml.scaffold.*

# Keep Cargo.lock. The workspace builds binaries, so the lockfile is committed for
# reproducible builds. The negation re-includes it in case a global gitignore
# excludes it.
!Cargo.lock

# --- debug / profiling byproducts ---
# perf
perf.data
perf.data.old
*.perf
perf.folded
*.folded

# flamegraph
flamegraph.svg
flamegraph.html

# core dumps. `core.*` and bare `core` are deliberately absent, for different
# reasons: `core.*` also matches a Rust source file named core.rs, and bare
# `core` matches anything so named, such as a topic crate or a src/bin/ program
# directory. systemd-coredump takes the dump anyway.
core.[0-9]*
*.core
vgcore.*

# valgrind (callgrind / cachegrind / massif)
callgrind.out.*
cachegrind.out.*
massif.out.*

# strace / ltrace
*.strace
*.ltrace

# ftrace-family (trace-cmd)
trace.dat
trace-*.dat

# gprof
gmon.out

# coverage instrumentation
*.profraw
*.profdata

# debugger history / cache logs
.gdb_history
.lldb_history
sccache.log

# --- ffi byproducts (hand-compiled C for the ffi topic) ---
*.o
*.a
*.so

# harness worktrees; a committed .claude/settings.json stays visible
.claude/worktrees/

# --- editor / OS noise ---
*.swp
*.swo
*~
*.orig
*.rej
.idea/
.vscode/
.DS_Store
Thumbs.db
