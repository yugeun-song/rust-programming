# Rust build artifacts
/target
**/*.rs.bk

# Keep Cargo.lock. This workspace ships a binary (hello_world), so the lockfile is
# committed for reproducible builds. The negation also re-includes it in case a
# global gitignore excludes Cargo.lock.
!Cargo.lock

# --- debug / profiling byproducts ---
# perf
perf.data
perf.data.old
*.perf
perf.folded
*.folded
# flamegraph
flamegraph.svg
flamegraph.html
# core dumps
core
core.*
*.core
vgcore.*
# valgrind (callgrind / cachegrind / massif)
callgrind.out.*
cachegrind.out.*
massif.out.*
# strace / ltrace
*.strace
*.ltrace
# ftrace-family (trace-cmd)
trace.dat
trace-*.dat
# debugger history / cache logs
.gdb_history
sccache.log

# --- editor / OS noise ---
*.swp
*.swo
*~
.idea/
.vscode/
.DS_Store
Thumbs.db
