root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4

[*.{yaml,yml,json}]
indent_style = space
indent_size = 2

# 4 matches Cargo.toml and .cargo/config.toml, and the members entries
# ./scaffold writes. The roadmap tables in .project.toml are 2.
[*.toml]
indent_style = space
indent_size = 4

[.project.toml]
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
# Markdown allows trailing whitespace (hard line break), so do not trim it.
trim_trailing_whitespace = false

[{scaffold,*.sh,*.bash,*.zsh}]
indent_style = space
indent_size = 4
