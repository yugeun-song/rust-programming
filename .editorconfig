root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4

[*.{toml,yaml,yml,json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
# Markdown allows trailing whitespace (hard line break), so do not trim it.
trim_trailing_whitespace = false

[*.sh]
indent_style = space
indent_size = 4
